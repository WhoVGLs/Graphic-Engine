{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GraphicEngine",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-msys/GraphicEngine.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "CMake: Build",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
